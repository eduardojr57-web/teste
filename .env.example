# Copie para .env somente no desenvolvimento local. No Render, use Environment.
APP_URL=http://localhost:3000
PORT=3000
# Obrigatório em produção: URL interna do Render Postgres.
DATABASE_URL=
DATA_DIR=data
# Gere dois segredos diferentes com pelo menos 32 caracteres aleatórios.
BOOTSTRAP_TOKEN=
BACKUP_KEY=
# No Render gratuito, use a API HTTPS de e-mail.
RESEND_API_KEY=
EMAIL_FROM=
FREE_TIER=true
# Data ISO opcional para mostrar a expiração do banco gratuito.
FREE_DATABASE_EXPIRES_AT=
# SMTP só funciona fora das restrições de portas do plano gratuito.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Chamadas em redes restritas: configure credenciais do seu provedor TURN.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
